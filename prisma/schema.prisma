generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js v5 + Credentials provider)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  coupleAccount  CoupleAccount?
  plannerAccount PlannerAccount?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain — Account types
// ---------------------------------------------------------------------------

/// Free-tier couple account. One per user. One wedding maximum.
model CoupleAccount {
  id            String @id @default(cuid())
  userId        String @unique
  guestCap      Int    @default(50)
  templateLimit Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding Wedding?
}

/// Professional planner account. One per user. Multiple weddings.
model PlannerAccount {
  id           String @id @default(cuid())
  userId       String @unique
  weddingLimit Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddings Wedding[]
}

// ---------------------------------------------------------------------------
// Domain — Wedding
// ---------------------------------------------------------------------------

model Wedding {
  id               String  @id @default(cuid())
  name             String
  date             DateTime
  senderName       String?
  coupleAccountId  String? @unique
  plannerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupleAccount  CoupleAccount?  @relation(fields: [coupleAccountId], references: [id], onDelete: Cascade)
  plannerAccount PlannerAccount? @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  ceremonies     Ceremony[]
  guests         Guest[]
  guestGroups    GuestGroup[]
  invitations    Invitation[]
}

enum CeremonyType {
  COUTUMIER
  CIVIL
  RELIGIEUX
  CUSTOM
}

model Ceremony {
  id          String      @id @default(cuid())
  type        CeremonyType @default(CUSTOM)
  customLabel String?     // display name when type = CUSTOM
  date        DateTime?   // combined date + time (UTC)
  venue       String?
  position    Int         @default(0) // user-set sort order
  weddingId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding          Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestAssignments GuestCeremony[]
  invitations      Invitation[]
}

model GuestCeremony {
  guestId    String
  ceremonyId String
  rsvp       RsvpStatus @default(PENDING)

  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  ceremony Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)

  @@id([guestId, ceremonyId])
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GuestType {
  SINGLETON
  COUPLE
}

enum Gender {
  MR
  MME
}

model Guest {
  id           String    @id @default(cuid())
  name         String
  guestType    GuestType @default(SINGLETON)
  gender       Gender?   // null for COUPLE
  phone        String?
  email        String?
  mealPref     String?
  plusOneName  String?
  plusOnePhone String?
  plusOneEmail String?
  weddingId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding             Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  ceremonyAssignments GuestCeremony[]
  groupMemberships    GuestGroupMember[]
  invitations         Invitation[]
}

model GuestGroup {
  id        String @id @default(cuid())
  name      String
  weddingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  members GuestGroupMember[]
}

model GuestGroupMember {
  guestId String
  groupId String

  guest Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  group GuestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([guestId, groupId])
}

// ---------------------------------------------------------------------------
// Domain — Invitations
// ---------------------------------------------------------------------------

enum Channel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Invitation {
  id         String             @id @default(cuid())
  weddingId  String
  guestId    String
  ceremonyId String
  templateId String             // slug from static template catalog
  channel    Channel
  status     NotificationStatus @default(PENDING)
  customBody String?            // paid-user body override
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding  Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  ceremony Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)
}
