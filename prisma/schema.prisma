generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js v5 + Credentials provider)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  coupleAccount  CoupleAccount?
  plannerAccount PlannerAccount?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain — Account types
// ---------------------------------------------------------------------------

/// Free-tier couple account. One per user. One wedding maximum.
model CoupleAccount {
  id            String @id @default(cuid())
  userId        String @unique
  guestCap      Int    @default(50)
  templateLimit Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding Wedding?
}

/// Professional planner account. One per user. Multiple weddings.
model PlannerAccount {
  id           String @id @default(cuid())
  userId       String @unique
  weddingLimit Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddings Wedding[]
}

// ---------------------------------------------------------------------------
// Domain — Wedding
// ---------------------------------------------------------------------------

model Wedding {
  id               String  @id @default(cuid())
  name             String
  date             DateTime
  coupleAccountId  String? @unique
  plannerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupleAccount  CoupleAccount?  @relation(fields: [coupleAccountId], references: [id], onDelete: Cascade)
  plannerAccount PlannerAccount? @relation(fields: [plannerAccountId], references: [id], onDelete: Cascade)
  ceremonies     Ceremony[]
  guests         Guest[]
}

model Ceremony {
  id        String    @id @default(cuid())
  name      String
  date      DateTime?
  weddingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Guest {
  id        String     @id @default(cuid())
  name      String
  weddingId String
  rsvp      RsvpStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}
